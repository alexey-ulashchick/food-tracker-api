{
  "name": "food-traker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:neon": "env -u DATABASE_URL bun --env-file=.env.neon run dev",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web --noEmit",
    "//lint": "Formatter is enforced on new code only. src/ predates any CI formatting check and has drifted; reformatting it would strip the padded numeric literals that keep the threshold tables in src/lib/dietDayClassifier.ts readable, for no behavioural gain. So: full check on new code, lint rules only on src/.",
    "lint": "biome check web/src && biome lint src",
    "format": "biome format --write web/src",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "test:web": "vitest run --passWithNoTests",
    "db:push": "drizzle-kit push",
    "db:push:neon": "env -u DATABASE_URL bun --env-file=.env.neon run db:push",
    "db:studio": "drizzle-kit studio",
    "db:studio:neon": "env -u DATABASE_URL bun --env-file=.env.neon run db:studio",
    "import:md": "bun scripts/import-md.ts",
    "import:md:neon": "env -u DATABASE_URL bun --env-file=.env.neon run import:md",
    "issue-token": "bun scripts/issue-token.ts",
    "issue-token:neon": "env -u DATABASE_URL bun --env-file=.env.neon run issue-token",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hono/zod-validator": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.102.8",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "motion": "^13.2.0",
    "postgres": "^3.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^3.23.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
