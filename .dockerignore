# Don't ship local-only or sensitive stuff to the build context.

node_modules
.env
.env.*
!.env.example
*.log
.DS_Store
.git
.gitignore
.gitattributes
README.md
docker-compose.yml
drizzle/
tests/
scripts/
biome.json
bunfig.toml

# web/ itself IS needed — the webbuild stage compiles it. Only its local
# artefacts are excluded; the bundle is built inside the image.
web/node_modules
web/dist
playwright-report
test-results
e2e/
playwright.config.ts
